{
  "expo": {
    "name": "图灵AI学伴",
    "slug": "turing-ai-companion",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/course/turing.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/course/turing.png",
        "backgroundColor": "#FAF8F2"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/course/turing.png",
      "bundler": "metro",
      "output": "single",
      "name": "图灵AI学伴"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择一张作品图片，作品仅保存在当前设备。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
